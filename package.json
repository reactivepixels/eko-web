{
  "name": "@rpxl/eko-web",
  "version": "0.1.0",
  "description": "EKO's web playback engine: gapless + loudness-normalized Web Audio. The web-grade sibling of the native EKO player. (Not bit-perfect: that's a browser limit, not a goal.)",
  "type": "module",
  "license": "MIT",
  "author": "Rod Leviton",
  "homepage": "https://github.com/reactivepixels/eko-web",
  "repository": {
    "type": "git",
    "url": "https://github.com/reactivepixels/eko-web.git"
  },
  "keywords": [
    "audio",
    "web-audio",
    "gapless",
    "replaygain",
    "loudness",
    "normalization",
    "player",
    "eko"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    },
    "./replaygain": {
      "types": "./dist/replaygain.d.ts",
      "import": "./dist/replaygain.js",
      "require": "./dist/replaygain.cjs"
    },
    "./media-session": {
      "types": "./dist/media-session.d.ts",
      "import": "./dist/media-session.js",
      "require": "./dist/media-session.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness": "npm run build && npx --yes serve . -l 4321",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8",
    "vue": "^3.5.43"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
