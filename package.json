{
  "name": "@rpxl/eko-web",
  "version": "0.1.0",
  "description": "EKO's web playback engine — gapless + loudness-normalized Web Audio. The web-grade sibling of the native EKO player. (Not bit-perfect — that's a browser limit, not a goal.)",
  "type": "module",
  "license": "MIT",
  "author": "Rod Leviton",
  "homepage": "https://github.com/reactivepixels/eko-web",
  "repository": {
    "type": "git",
    "url": "https://github.com/reactivepixels/eko-web.git"
  },
  "keywords": [
    "audio",
    "web-audio",
    "gapless",
    "replaygain",
    "loudness",
    "normalization",
    "player",
    "eko"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
